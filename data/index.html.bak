<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CV</title>
  <meta name="color-scheme" content="dark" />
  <style>
    /* Dezent: Catppuccin-ish + Obsidian/Terminal */
    :root{
      --bg:#0b0f14;
      --panel:#0f1520;
      --panel2:#0c111a;
      --text:#e6e9ef;
      --muted:#9aa3b2;
      --border:rgba(230,233,239,.10);
      --shadow:0 18px 60px rgba(0,0,0,.45);
      --radius:18px;

      --acc:#89b4fa;      /* blue */
      --acc2:#a6e3a1;     /* green */
      --acc3:#f5c2e7;     /* mauve */
      --chipbg:rgba(137,180,250,.10);
      --chipbr:rgba(137,180,250,.18);

      --max:1100px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      color:var(--text);
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      background:
        radial-gradient(900px 520px at 20% 0%, rgba(137,180,250,.14), transparent 55%),
        radial-gradient(900px 520px at 85% 10%, rgba(166,227,161,.10), transparent 55%),
        radial-gradient(900px 520px at 70% 85%, rgba(245,194,231,.08), transparent 60%),
        var(--bg);
    }
    a{color:inherit; text-decoration:none}
    a:hover{opacity:.92}
    .wrap{max-width:var(--max); margin:0 auto; padding:26px 16px 60px;}

    /* Layout: links Intro (sticky), rechts Inhalte */
    .layout{
      display:grid;
      grid-template-columns: 360px 1fr;
      gap:16px;
      align-items:start;
    }
    @media (max-width: 980px){
      .layout{grid-template-columns:1fr}
      .sticky{position:static}
    }

    .card{
      border:1px solid var(--border);
      background: linear-gradient(180deg, rgba(230,233,239,.04), rgba(230,233,239,.02));
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
      backdrop-filter: blur(6px);
    }

    .sticky{
      position: sticky;
      top: 16px;
    }

    .intro{
      padding:18px;
      background:
        radial-gradient(800px 240px at 25% -20%, rgba(137,180,250,.16), transparent 60%),
        radial-gradient(600px 240px at 80% 0%, rgba(166,227,161,.10), transparent 55%);
      border-bottom:1px solid var(--border);
    }

    .name{
      margin:0;
      font-size:28px;
      line-height:1.15;
      letter-spacing:-.02em;
      font-weight:900;
    }
    .role{margin:8px 0 0; color:var(--muted); font-weight:750}
    .meta{display:flex; flex-wrap:wrap; gap:8px; margin-top:14px}
    .pill{
      display:inline-flex; align-items:center; gap:8px;
      padding:8px 10px;
      border-radius:999px;
      border:1px solid var(--border);
      background: rgba(230,233,239,.04);
      color: var(--muted);
      font-weight:750;
      font-size:13px;
      white-space:nowrap;
    }
    .dot{
      width:8px; height:8px; border-radius:999px;
      background: linear-gradient(135deg, var(--acc), var(--acc2));
      box-shadow: 0 0 0 4px rgba(137,180,250,.10);
    }

    .side{padding:14px 18px 18px}
    .h{margin:0 0 10px; font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted)}
    .summary{color:var(--text); opacity:.92; line-height:1.55}
    .mono{font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;}

    .controls{display:flex; flex-direction:column; gap:10px; margin-top:14px}
    .search{
      width:100%;
      padding:11px 12px;
      border-radius:12px;
      border:1px solid var(--border);
      background: rgba(15,21,32,.55);
      color: var(--text);
      outline:none;
      font-weight:650;
    }
    .search::placeholder{color: rgba(154,163,178,.75)}

    .tags{display:flex; flex-wrap:wrap; gap:8px}
    .tag{
      border:1px solid var(--chipbr);
      background: var(--chipbg);
      color: rgba(230,233,239,.92);
      border-radius:999px;
      padding:7px 10px;
      font-weight:850;
      font-size:12px;
      cursor:pointer;
      user-select:none;
    }
    .tag[data-on="1"]{
      border-color: rgba(166,227,161,.35);
      background: rgba(166,227,161,.12);
    }

    .main{padding:18px}
    .section + .section{margin-top:18px}
    .sectionhead{
      display:flex; justify-content:space-between; align-items:baseline; gap:10px;
      margin-bottom:10px;
    }
    .sectionhead .h{margin:0}
    .count{color:var(--muted); font-weight:800; font-size:12px}

    /* Cards wie "Work"-Tiles */
    .gridcards{
      display:grid;
      grid-template-columns: 1fr;
      gap:12px;
    }
    .item{
      border:1px solid var(--border);
      border-radius:14px;
      background: rgba(15,21,32,.55);
      padding:14px;
      transition: transform .10s ease, border-color .18s ease, background .18s ease;
    }
    .item:hover{
      transform: translateY(-1px);
      border-color: rgba(230,233,239,.16);
      background: rgba(15,21,32,.70);
    }
    .top{
      display:flex; justify-content:space-between; gap:10px; align-items:flex-start;
    }
    .title{font-weight:950; letter-spacing:-.01em}
    .sub{color:var(--muted); font-weight:800; margin-top:3px}
    .date{color:var(--muted); font-weight:850; white-space:nowrap}
    ul{margin:10px 0 0; padding-left:18px}
    li{margin:6px 0; line-height:1.45}
    .chips{display:flex; flex-wrap:wrap; gap:8px; margin-top:10px}
    .chip{
      border:1px solid var(--border);
      background: rgba(230,233,239,.04);
      border-radius:999px;
      padding:7px 10px;
      font-weight:850;
      font-size:12px;
      color: rgba(230,233,239,.92);
    }

    .footer{
      margin-top:16px;
      color:var(--muted);
      font-weight:750;
      font-size:12px;
      display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap;
    }

    details{
      border:1px solid var(--border);
      border-radius:14px;
      background: rgba(15,21,32,.55);
      overflow:hidden;
    }
    summary{
      cursor:pointer;
      padding:12px 14px;
      font-weight:900;
      list-style:none;
      color: rgba(230,233,239,.92);
    }
    summary::-webkit-details-marker{display:none}
    details .pad{padding:0 14px 14px}

    pre{
      margin:0;
      padding:12px 14px;
      border-radius:14px;
      border:1px solid var(--border);
      background: rgba(12,17,26,.75);
      color: rgba(230,233,239,.92);
      overflow:auto;
      white-space:pre-wrap;
    }

    @media print{
      body{background:#fff; color:#000}
      .card{box-shadow:none}
      .controls{display:none}
      :root{--border: rgba(0,0,0,.15)}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="layout">
      <!-- LEFT -->
      <div class="card sticky">
        <div class="intro">
          <div class="pill"><span class="dot"></span><span class="mono">/cv.json</span></div>
          <h1 class="name" id="name">lädt…</h1>
          <div class="role" id="role"></div>
          <div class="meta" id="meta"></div>
        </div>

        <div class="side">
          <div class="h">Profil</div>
          <div class="summary" id="summary"></div>

          <div class="controls">
            <input class="search" id="q" placeholder="Suche (Firma, Rolle, Tech, Text) …" />
            <div>
              <div class="h">Filter Tech</div>
              <div class="tags" id="tags"></div>
              <div class="footer">
                <div id="active"></div>
                <a href="#" onclick="window.print(); return false;">Drucken</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="card">
        <div class="main">
          <div class="section" id="sec-exp">
            <div class="sectionhead">
              <div class="h">Erfahrung</div>
              <div class="count" id="expCount"></div>
            </div>
            <div class="gridcards" id="exp"></div>
          </div>

          <div class="section" id="sec-proj">
            <div class="sectionhead">
              <div class="h">Private Projekte</div>
              <div class="count" id="projCount"></div>
            </div>
            <div class="gridcards" id="proj"></div>
          </div>

          <div class="section">
            <div class="sectionhead">
              <div class="h">Skills</div>
              <div class="count" id="skillsCount"></div>
            </div>
            <div id="skills"></div>
          </div>

          <div class="section">
            <div class="sectionhead">
              <div class="h">JSON</div>
              <div class="count">Debug</div>
            </div>
            <pre class="mono" id="raw"></pre>
          </div>

          <div class="footer">
            <div id="ts"></div>
            <div class="mono">cv.local.ahrd.net</div>
          </div>
        </div>
      </div>
    </div>
  </div>

<script>
  const el = (id) => document.getElementById(id);
  const safeArray = (x) => Array.isArray(x) ? x : [];
  const safeObj = (x) => (x && typeof x === "object" && !Array.isArray(x)) ? x : {};

  function fmtYM(s){
    if(!s) return "Heute";
    const m = String(s).match(/^(\d{4})-(\d{2})$/);
    if(!m) return s;
    return `${m[2]}.${m[1]}`; // MM.YYYY
  }

  function uniq(arr){
    return [...new Set(arr.filter(Boolean).map(String))].sort((a,b)=>a.localeCompare(b));
  }

  function buildMeta(b){
    const out = [];
    if(b.location) out.push(`<span class="pill">📍 ${b.location}</span>`);
    return out.join("");
  }

  function renderExperience(e){
    const hi = safeArray(e.highlights).map(h => `<li>${h}</li>`).join("");
    const tech = safeArray(e.tech).map(t => `<span class="chip mono">${t}</span>`).join("");
    const date = `${fmtYM(e.start)} – ${fmtYM(e.end)}`;
    const domain = e.domain ? ` · ${e.domain}` : "";
    return `
      <div class="item" data-kind="exp" data-text="${escapeText(blobTextExp(e))}">
        <div class="top">
          <div>
            <div class="title">${escapeHtml(e.position || "—")}</div>
            <div class="sub">${escapeHtml(e.company || "—")}${escapeHtml(domain)}</div>
          </div>
          <div class="date mono">${escapeHtml(date)}</div>
        </div>
        ${hi ? `<ul>${hi}</ul>` : ``}
        ${tech ? `<div class="chips">${tech}</div>` : ``}
      </div>
    `;
  }

  function renderProject(p){
    const hi = safeArray(p.highlights).map(h => `<li>${h}</li>`).join("");
    const tech = safeArray(p.tech).map(t => `<span class="chip mono">${t}</span>`).join("");
    return `
      <div class="item" data-kind="proj" data-text="${escapeText(blobTextProj(p))}">
        <div class="top">
          <div>
            <div class="title">${escapeHtml(p.name || "—")}</div>
            <div class="sub muted">Self-hosted / Home Lab</div>
          </div>
          <div class="date mono">—</div>
        </div>
        ${hi ? `<ul>${hi}</ul>` : ``}
        ${tech ? `<div class="chips">${tech}</div>` : ``}
      </div>
    `;
  }

  function renderSkills(skillsObj){
    const o = safeObj(skillsObj);
    const entries = Object.entries(o);
    if(!entries.length) return `<div class="muted">—</div>`;

    return entries.map(([k, arr]) => {
      const items = safeArray(arr);
      const label = k.replaceAll("_"," ").replace(/\b\w/g, c => c.toUpperCase());
      const chips = items.map(x => `<span class="chip mono">${escapeHtml(x)}</span>`).join("");
      return `
        <details open>
          <summary>${escapeHtml(label)} <span class="muted">(${items.length})</span></summary>
          <div class="pad">
            <div class="chips">${chips || `<span class="muted">—</span>`}</div>
          </div>
        </details>
        <div style="height:10px"></div>
      `;
    }).join("");
  }

  function escapeHtml(s){
    return String(s).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;");
  }
  function escapeText(s){
    return escapeHtml(s).replaceAll("\n"," ").replaceAll("\r"," ");
  }
  function blobTextExp(e){
    return [
      e.company, e.position, e.domain, e.start, e.end,
      ...safeArray(e.highlights),
      ...safeArray(e.tech),
    ].filter(Boolean).join(" | ");
  }
  function blobTextProj(p){
    return [p.name, ...safeArray(p.highlights), ...safeArray(p.tech)].filter(Boolean).join(" | ");
  }

  function collectTech(cv){
    const exp = safeArray(cv.experience).flatMap(x => safeArray(x.tech));
    const proj = safeArray(cv.projects_private).flatMap(x => safeArray(x.tech));
    return uniq([...exp, ...proj]);
  }

  function applyFilter(){
    const q = el("q").value.trim().toLowerCase();
    const active = [...el("tags").querySelectorAll(".tag[data-on='1']")].map(x => x.dataset.t);

    let visibleExp = 0, visibleProj = 0;

    document.querySelectorAll(".item").forEach(card => {
      const text = (card.dataset.text || "").toLowerCase();

      // search match
      const matchQ = !q || text.includes(q);

      // tag match: all selected must be in text (simple but robust)
      const matchTags = active.every(t => text.includes(t.toLowerCase()));

      const ok = matchQ && matchTags;
      card.style.display = ok ? "" : "none";

      if(ok && card.dataset.kind === "exp") visibleExp++;
      if(ok && card.dataset.kind === "proj") visibleProj++;
    });

    el("expCount").textContent = `${visibleExp} sichtbar`;
    el("projCount").textContent = `${visibleProj} sichtbar`;
    el("active").textContent = active.length ? `Filter: ${active.join(", ")}` : "Filter: —";
  }

  async function load(){
    const r = await fetch("/cv.json", { cache:"no-store" });
    if(!r.ok) throw new Error(`${r.status} ${r.statusText}`);
    const cv = await r.json();

    const b = safeObj(cv.basics);
    el("name").textContent = b.name || "—";
    el("role").textContent = b.role || "";
    el("meta").innerHTML = buildMeta(b);
    el("summary").textContent = b.summary || "—";

    // experience sort by start desc
    const exp = safeArray(cv.experience).slice().sort((a,b)=>String(b.start||"").localeCompare(String(a.start||"")));
    el("exp").innerHTML = exp.map(renderExperience).join("") || `<div class="muted">—</div>`;

    const proj = safeArray(cv.projects_private);
    el("proj").innerHTML = proj.map(renderProject).join("") || `<div class="muted">—</div>`;

    // skills
    el("skills").innerHTML = renderSkills(cv.skills);
    const skillsCount = Object.values(safeObj(cv.skills)).reduce((n,v)=> n + (Array.isArray(v)?v.length:0), 0);
    el("skillsCount").textContent = `${skillsCount} Einträge`;

    // tags
    const tech = collectTech(cv);
    el("tags").innerHTML = tech.map(t => `<span class="tag mono" data-t="${escapeHtml(t)}" data-on="0">${escapeHtml(t)}</span>`).join("") || `<span class="muted">—</span>`;
    el("tags").querySelectorAll(".tag").forEach(tag => {
      tag.addEventListener("click", () => {
        tag.dataset.on = (tag.dataset.on === "1") ? "0" : "1";
        applyFilter();
      });
    });

    // raw debug (gekürzt)
    const raw = JSON.stringify(cv, null, 2);
    el("raw").textContent = raw.length > 5000 ? raw.slice(0, 5000) + "\n…(gekürzt)" : raw;

    el("ts").textContent = `Stand: ${new Date().toLocaleString("de-CH")}`;

    el("q").addEventListener("input", applyFilter);
    applyFilter();
  }

  load().catch(e => {
    el("name").textContent = "Fehler";
    el("summary").textContent = String(e);
  });
</script>
</body>
</html>